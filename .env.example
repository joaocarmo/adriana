# Copy to .env for local development. .env is git-ignored; this file is not.
# CI gets the same names from GitHub Actions secrets instead.

# Obvious dummies. Adriana's real number and address belong only in the
# GitHub secrets, never in a file on disk.
WHATSAPP_NUMBER=351900000000
CONTACT_EMAIL=exemplo@exemplo.pt

# Decrypts assets/*.enc, so the build can put the real photograph on the page.
# Must match the ASSETS_KEY GitHub secret. Generate with: openssl rand -base64 32
ASSETS_KEY=
